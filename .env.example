# Copy to .env and edit as needed. Every value below has a working default,
# so local development runs fine with no .env file at all.
#
# Vite only exposes variables prefixed VITE_, and inlines them at BUILD time.
# That means:
#   - changing a value requires restarting `npm run dev`
#   - nothing here is secret; it all ends up in the shipped JS bundle.
#     Never put an API key, token, or password in this file.

# ── API location ─────────────────────────────────────────────────────────
# By default the app calls the backend on the SAME host it was served from,
# on VITE_API_PORT. That default is what makes phone testing work: open the
# app at http://192.168.1.8:5173 and it calls http://192.168.1.8:4995, rather
# than a hardcoded "localhost" the phone would resolve to itself.
#
# Only set VITE_API_BASE_URL for a real deployment, where the API lives on
# its own host/scheme rather than a port on the machine serving the frontend.
# When set, it wins and VITE_API_PORT is ignored.
VITE_API_PORT=4995
# VITE_API_BASE_URL=https://api.example.com

# ── App behaviour ────────────────────────────────────────────────────────
# The search that runs when /search is opened without its own ?q=.
VITE_DEFAULT_SEARCH_QUERY=laptop

# Products per page on a category page. The backend rejects anything above
# 50, so larger values are clamped to 50 rather than sent through.
VITE_CATEGORY_PAGE_SIZE=20
